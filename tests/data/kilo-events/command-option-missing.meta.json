{
  "case": "command-option-missing",
  "about": "kilo run --command naming a command that isn't there",
  "date": "2026-11-06",
  "kilo_version": "7.8.18",
  "model": "kilo/anthropic/claude-haiku-4.5",
  "argv": [
    "kilo",
    "run",
    "--pure",
    "--format",
    "json",
    "-m",
    "kilo/anthropic/claude-haiku-4.5",
    "--command",
    "no-such-command",
    "--",
    "Reply with exactly the word OK."
  ],
  "overlay": {
    "permission": {
      "bash": "allow",
      "edit": "allow"
    }
  },
  "project_files": {},
  "home_files": {},
  "exit_code": 1,
  "stderr": "\u001b[91m\u001b[1mError: \u001b[0mCommand not found: \"no-such-command\". Available commands: compact, goal, init, kilo-config, resume-claude, resume-codex, review, summarize\n",
  "git_status_after": "",
  "trimmed": "strings over 1200 characters cut; event types kept: all",
  "placeholders": {
    "project folder": "/tmp/kilo-eval-XXXXXXXX/project",
    "temporary HOME": "/tmp/kilo-eval-home-XXXXXXXX",
    "other temporary paths": "/tmp/",
    "Kilo login values": "[redacted]",
    "user's home folder": "/home/user",
    "user name": "user",
    "email addresses other than the git identity": "user@example.invalid",
    "gateway request id (step_finish vercelID)": "REQUEST-ID-PLACEHOLDER"
  }
}
